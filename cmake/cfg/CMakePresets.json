{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "hpm-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "GNURISCV_TOOLCHAIN_PATH": "${sourceDir}/.tools/hpm-gcc-13.2.0",
        "HPM_SDK_TOOLCHAIN_VARIANT": "gcc",
        "PATH": "${sourceDir}/.tools/host/usr/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "APP_NAME": "dcu",
        "HPM_BUILD_TYPE": "flash_xip",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/host/usr/bin/ninja",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "EXCLUDED_IDE_IAR": true,
        "EXCLUDED_IDE_SES": true,
        "CONFIG_CAN_LED_TEST": false,
        "CONFIG_CAN_INTERNAL_LOOPBACK_TEST": false,
        "CONFIG_ETHERCAT_SCAN_TEST": false,
        "CONFIG_ETHERCAT_DATA_TEST": false,
        "CONFIG_ETHERCAT_MCAN_ECHO": false,
        "CONFIG_GATEWAY_STATIC_PROFILE": false,
        "CONFIG_GATEWAY_SESSION_TEST": false
      }
    },
    {
      "name": "hpm-debug",
      "inherits": "hpm-base",
      "displayName": "HPM5E31 Flash XIP Debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "debug"}
    },
    {
      "name": "hpm-release",
      "inherits": "hpm-base",
      "displayName": "HPM5E31 Flash XIP Release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "release"}
    },
    {
      "name": "hpm-can-loopback",
      "inherits": "hpm-base",
      "displayName": "HPM5E31 Isolated MCAN0 Internal Loopback",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "debug",
        "CONFIG_CAN_INTERNAL_LOOPBACK_TEST": true
      }
    },
    {
      "name": "hpm-ethercat-scan",
      "inherits": "hpm-base",
      "displayName": "HPM5E31 Isolated EtherCAT Discovery",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "debug",
        "CONFIG_ETHERCAT_SCAN_TEST": true
      }
    },
    {
      "name": "hpm-ethercat-data",
      "inherits": "hpm-base",
      "displayName": "HPM5E31 Isolated EtherCAT Data Echo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "debug",
        "CONFIG_ETHERCAT_DATA_TEST": true
      }
    },
    {
      "name": "hpm-ethercat-mcan",
      "inherits": "hpm-ethercat-data",
      "displayName": "HPM5E31 Isolated EtherCAT to MCAN0 Internal Echo",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CONFIG_ETHERCAT_MCAN_ECHO": true}
    },
    {
      "name": "hpm-gateway-profile",
      "inherits": "hpm-ethercat-mcan",
      "displayName": "HPM5E31 Offline Single-CAN Profile Gateway",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CONFIG_GATEWAY_STATIC_PROFILE": true}
    },
    {
      "name": "hpm-gateway-session",
      "inherits": "hpm-gateway-profile",
      "displayName": "HPM5E31 Offline Gateway Session Gate",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CONFIG_GATEWAY_SESSION_TEST": true}
    }
  ],
  "buildPresets": [
    {"name": "hpm-debug", "configurePreset": "hpm-debug", "jobs": 4},
    {"name": "hpm-release", "configurePreset": "hpm-release", "jobs": 4},
    {"name": "hpm-can-loopback", "configurePreset": "hpm-can-loopback", "jobs": 4},
    {"name": "hpm-ethercat-scan", "configurePreset": "hpm-ethercat-scan", "jobs": 4},
    {"name": "hpm-ethercat-data", "configurePreset": "hpm-ethercat-data", "jobs": 4},
    {"name": "hpm-ethercat-mcan", "configurePreset": "hpm-ethercat-mcan", "jobs": 4},
    {"name": "hpm-gateway-profile", "configurePreset": "hpm-gateway-profile", "jobs": 4},
    {"name": "hpm-gateway-session", "configurePreset": "hpm-gateway-session", "jobs": 4}
  ],
  "testPresets": [
    {
      "name": "hpm-debug",
      "configurePreset": "hpm-debug",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error"}
    }
  ]
}
