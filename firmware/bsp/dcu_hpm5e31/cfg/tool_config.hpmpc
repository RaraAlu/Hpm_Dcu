                "SPD": "3",
                "PE": "1",
                "PS": "1",
                "PRS": "1"
              }
            },
            "PC10": {
              "signal": "SPI1.B.SCLK",
              "padCtls": {
                "LOOP_BACK": "1",
                "SR": "1",
                "SPD": "3"
              }
            },
            "PC12": {
              "signal": "SPI1.B.MISO",
              "padCtls": {
                "SR": "1",
                "SPD": "3"
              }
            },
            "PC13": {
              "signal": "SPI1.B.MOSI",
              "padCtls": {
                "SR": "1",
                "SPD": "3"
              }
            }
          },
          "annotation": "set max frequency slew rate(200M)"
        },
